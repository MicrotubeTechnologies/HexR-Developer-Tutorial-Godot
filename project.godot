; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="HexR Godot Developer Tutorial"
config/description="The HexR haptic glove in Godot: grab, pinch, press, pulse, fountain and rain."
config/version="0.2.0"
run/main_scene="res://scenes/1_basic_tutorial.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"

[autoload]

XRToolsUserSettings="*uid://bqgb8i74tm0t"
XRToolsRumbleManager="*uid://by853dk86g1qw"
HexR="*res://addons/hexr/core/hexr_manager.gd"

[display]

window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-xr-tools/plugin.cfg", "res://addons/hexr/plugin.cfg")

[hexr]

scenes=PackedStringArray("res://scenes/1_basic_tutorial.tscn", "res://scenes/3_water_effects.tscn")

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_20="hexr_touch"
3d_physics/layer_21="hexr_interactable"

[physics]

common/enable_object_picking=false

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1

[xr]

openxr/enabled=true
openxr/reference_space=2
openxr/foveation_level=3
openxr/foveation_dynamic=true
openxr/extensions/hand_tracking=true
openxr/extensions/hand_interaction_profile=true
shaders/enabled=true
